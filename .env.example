# Copy this to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
# Leave DATABASE_URL empty to use local SQLite. Set it in production for PostgreSQL.
DATABASE_URL=
# Or configure PostgreSQL with individual values instead of DATABASE_URL.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
# Optional outside Vercel: run migrations when the app starts.
AUTO_MIGRATE_ON_STARTUP=False
# Optional outside Vercel: copy bundled/local SQLite data into PostgreSQL on startup.
AUTO_SYNC_SQLITE_TO_POSTGRES=False
SQLITE_SYNC_SOURCE=db.sqlite3

# Twitter / X API (for auto-posting blog posts)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# LinkedIn API (for auto-posting blog posts)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
